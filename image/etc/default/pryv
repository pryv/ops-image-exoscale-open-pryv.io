# Open Pryv.io service settings, read by pryv.service and the scripts in /opt/pryv.
# Filled at first boot by /opt/pryv/first-boot.sh with the release it resolved,
# verified and pulled (PRYV_VERSION in /opt/pryv/first-boot.env), then by
# /opt/pryv/pryv-upgrade.sh. Do not edit PRYV_IMAGE by hand: the upgrade script
# verifies the release signature first.
PRYV_IMAGE=
PRYV_CONFIG_DIR=/opt/pryv
